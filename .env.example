# CanvasX Vision Environment Configuration
# Copy this file to .env.local for local development or set the same values in Vercel.
# Use VITE_ prefixes because this app is built with Vite.
# This workspace currently contains the frontend only.

# =================================
# Required: Tambo AI
# =================================
# Reuse the same key from your other Tambo project.
# Get your API key from: https://tambo.co/cli-auth
VITE_TAMBO_API_KEY=your_tambo_api_key_here

# =================================
# Optional: Backend API
# =================================
# Only set this if you deploy a separate backend service.
# Local development:
# VITE_API_BASE_URL=http://localhost:8000
# Production on Render:
# VITE_API_BASE_URL=https://your-backend.onrender.com

# =================================
# Application Configuration
# =================================
VITE_APP_ENV=production
VITE_APP_VERSION=0.0.1

# =================================
# Optional: Feature Flags
# =================================
VITE_ENABLE_AI=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_PREVIEW=true

# =================================
# Optional: Storage Configuration
# =================================
VITE_STORAGE_PREFIX=canvasx_
VITE_MAX_STORAGE_SIZE=100

# =================================
# Optional: Analytics & Monitoring
# =================================
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =================================
# Optional: Development Settings
# =================================
# VITE_DEBUG=false
# VITE_VERBOSE_LOGGING=false
