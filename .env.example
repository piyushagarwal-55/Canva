# CanvasX Vision Environment Configuration
# Copy this file to .env and fill in your actual values

# =================================
# Tambo AI Configuration
# =================================
# Get your API key from: https://tambo.ai/
VITE_TAMBO_API_KEY=your_tambo_api_key_here

# =================================
# API Configuration
# =================================
# Base URL for your backend API
VITE_API_BASE_URL=http://localhost:3000

# =================================
# Application Configuration
# =================================
# Application environment (development, staging, production)
VITE_APP_ENV=development

# Application version
VITE_APP_VERSION=0.0.1

# =================================
# Optional: Analytics & Monitoring
# =================================
# Google Analytics Tracking ID
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =================================
# Optional: Feature Flags
# =================================
# Enable/disable AI features
VITE_ENABLE_AI=true

# Enable/disable export functionality
VITE_ENABLE_EXPORT=true

# Enable/disable preview mode
VITE_ENABLE_PREVIEW=true

# =================================
# Optional: Storage Configuration
# =================================
# Local storage key prefix
VITE_STORAGE_PREFIX=canvasx_

# Maximum project storage size (in MB)
VITE_MAX_STORAGE_SIZE=100

# =================================
# Optional: Development Settings
# =================================
# Enable debug mode
# VITE_DEBUG=false

# Enable verbose logging
# VITE_VERBOSE_LOGGING=false
